# Copy this file to .env and fill in your values
# For Render deployment, set these as Environment Variables in the Render dashboard

# PostgreSQL (Render provides this as "Internal Database URL")
DB_URL=jdbc:postgresql://localhost:5432/chat_app
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT secret (any random 64+ char string)
JWT_SECRET=your_jwt_secret_at_least_64_chars_long_replace_this_placeholder_now

# Server port (Render sets PORT automatically)
PORT=8081
